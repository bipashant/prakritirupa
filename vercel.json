{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/she-who-is-nature.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"She-Who-Is-Nature-Bibek-Sharma-Chapagain.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(img|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/kindle",
      "destination": "/amazon",
      "permanent": true
    }
  ]
}
